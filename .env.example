# Copy to .env and edit. Never commit .env. This file holds defaults only, no secrets.
# docker compose reads .env automatically; the monitor reads it through env_file.
# Values under "Docker compose overrides" are replaced inside the compose stack.

# ---- HTTP server -------------------------------------------------------------
# Address the monitor + read-only API listens on.
ARGUS_HTTP_ADDR=:8080

# ---- Storage -----------------------------------------------------------------
# Postgres for snapshot history. Local default matches docker-compose Postgres.
# Compose overrides this with the postgres service host.
DATABASE_URL=postgres://argus:argus@localhost:5432/argus?sslmode=disable
# Redis for the alert queue. Leave empty to use the in-memory queue (single process only).
# Compose overrides this with the redis service host.
REDIS_URL=

# Postgres credentials used by the postgres service and by compose to build DATABASE_URL.
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus

# ---- NEAR RPC ----------------------------------------------------------------
# Comma-separated, tried in order with fallback. Free public mainnet endpoints.
# Verify against https://docs.near.org/api/rpc/providers before relying on them.
ARGUS_RPC_URLS=https://free.rpc.fastnear.com,https://rpc.mainnet.fastnear.com,https://rpc.mainnet.near.org
# Archival endpoints, used for replay and historical reads (block_id older than the RPC window).
ARGUS_ARCHIVAL_RPC_URLS=https://archival-rpc.mainnet.near.org,https://archival-rpc.mainnet.fastnear.com
# Requests per second per provider. Stay under the free-tier limit of each provider.
ARGUS_RPC_RPS=5

# ---- What is monitored -------------------------------------------------------
# Account that holds the NEAR Intents multi-token contract (the owed side reads from here).
ARGUS_INTENTS_ACCOUNT=intents.near
# Token discovery: a YAML file of tokens (see config/), and the public token list API.
ARGUS_TOKENS_FILE=config/tokens.yaml
ARGUS_ONECLICK_TOKENS_URL=https://1click.chaindefuser.com/v0/tokens
# Block and event source (neardata). Used for the event stream, which is off by default.
ARGUS_NEARDATA_URL=https://mainnet.neardata.xyz
ARGUS_EVENTS_ENABLED=false
# Requests per second against neardata (documented limit: 180/min/IP). Optional API key.
ARGUS_NEARDATA_RPS=2
ARGUS_NEARDATA_API_KEY=

# ---- Snapshot loop -----------------------------------------------------------
# Time between snapshots of owed vs held for every token.
ARGUS_INTERVAL=30s
# Alert only after the gap stays outside tolerance for K consecutive snapshots.
# Debounce protects against false alarms from in-flight deposits and withdrawals.
ARGUS_DEBOUNCE_K=4
# Optional absolute deficits (in the token's smallest units) that turn a token red
# immediately. Comma-separated <token id>=<amount>; "*" sets a default for all.
# Example: nep141:wrap.near=1000000000000000000000000000,nep141:usdt.tether-token.near=1000000000
ARGUS_RED_THRESHOLDS=
# Tokens per RPC batch, and the number of concurrent batches.
ARGUS_BATCH_SIZE=50
ARGUS_CONCURRENCY=8
# How often token discovery re-runs.
ARGUS_DISCOVERY_INTERVAL=24h

# ---- Alerts ------------------------------------------------------------------
# Telegram alerts are sent only when both values are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base URL used in alert links. Set to your dashboard's public address.
ARGUS_PUBLIC_URL=http://localhost:3000

# ---- API ---------------------------------------------------------------------
# Requests per minute per client IP on the public read-only API.
ARGUS_API_RATE_LIMIT=60
# Allowed CORS origins, comma-separated. "*" suits a public read-only API.
# Set to your dashboard origin (for example https://argus.pages.dev) to tighten it.
ARGUS_CORS_ORIGINS=*
# Set true only behind a reverse proxy that appends the client IP to X-Forwarded-For
# (the last entry is used for rate limiting).
ARGUS_TRUST_PROXY=false
# File served by GET /v1/replay (written by `go run ./cmd/replay`).
ARGUS_REPLAY_FILE=data/replay/2026-10-01.json

# ---- Optional AI summaries (P1, off by default) -------------------------------
# Any OpenAI-compatible endpoint. The LLM only writes text; it never decides alert state.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Operations --------------------------------------------------------------
# debug | info | warn | error
ARGUS_LOG_LEVEL=info
# How long snapshot history is kept (Go duration). 720h is 30 days.
ARGUS_RETENTION=720h

# ---- Dashboard (web/) ---------------------------------------------------------
# Used at dashboard build time. Empty means same-origin /v1 (the nginx proxy in compose).
# For Cloudflare Pages, set this to your monitor's public URL, for example https://argus-monitor.fly.dev
PUBLIC_API_BASE=
