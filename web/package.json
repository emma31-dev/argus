{
  "name": "argus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Argus dashboard: public, read-only solvency monitor for NEAR Intents.",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "node dev/mock-api.mjs --with-vite",
    "mock": "node dev/mock-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "screenshots": "node dev/screenshots.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.17"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/inter": "5.2.8",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.5",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
