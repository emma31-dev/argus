{
  "name": "argus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Argus dashboard: public, read-only solvency monitor for NEAR Intents.",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "node dev/mock-api.mjs --with-vite",
    "mock": "node dev/mock-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "screenshots": "node dev/screenshots.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/inter": "5.2.8",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.5",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
